{
  "expo": {
    "name": "Fasting",
    "slug": "fasting-tracker",
    "scheme": "fasting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F2",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kalyani.fasting",
      "adaptiveIcon": {
        "backgroundColor": "#1E6B62",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F3F5F2"
        }
      ],
      "./plugins/withNotificationIcon",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Poppins_400Regular.ttf",
            "./assets/fonts/Poppins_600SemiBold.ttf",
            "./assets/fonts/Poppins_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "FastWidget",
              "label": "Fasting",
              "description": "Your fast at a glance, with a push to keep going",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
